{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": false,
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
